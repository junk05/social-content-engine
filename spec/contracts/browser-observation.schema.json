{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://social-content-engine.local/contracts/browser-observation.schema.json",
  "title": "M3 Browser Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "observation_type", "source", "post_url", "source_post_id",
    "author_name", "username", "text", "timestamp", "public_counters", "media_type",
    "has_image", "has_video", "collection_context", "observed_fields", "collected_at",
    "extractor_version", "payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "observation_type": {"enum": ["SEARCH_CARD", "POST_DETAIL"]},
    "source": {"const": "threads"},
    "post_url": {
      "type": "string",
      "pattern": "^https://www\\.threads\\.net/@[A-Za-z0-9._-]+/post/[A-Za-z0-9._-]+$"
    },
    "source_post_id": {"type": ["string", "null"], "minLength": 1},
    "author_name": {"type": ["string", "null"]},
    "username": {"type": ["string", "null"]},
    "text": {"type": ["string", "null"]},
    "topic_tags": {
      "type": "array", "maxItems": 20, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    },
    "raw_sequence_indicator": {"type": ["string", "null"], "pattern": "^\\s*\\d+\\s*/\\s*\\d+\\s*$"},
    "thread_position": {"type": ["integer", "null"], "minimum": 1},
    "thread_total": {"type": ["integer", "null"], "minimum": 1},
    "timestamp": {"type": ["string", "null"], "format": "date-time"},
    "published_at_raw": {"type": ["string", "null"], "maxLength": 128},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "published_timezone_basis": {
      "enum": ["TIME_DATETIME_EXPLICIT_OFFSET", "NOT_OBSERVED"]
    },
    "public_counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_count", "like_count", "reply_count", "repost_count", "quote_count", "share_count"
      ],
      "properties": {
        "view_count": {"type": ["integer", "null"], "minimum": 0},
        "like_count": {"type": ["integer", "null"], "minimum": 0},
        "reply_count": {"type": ["integer", "null"], "minimum": 0},
        "repost_count": {"type": ["integer", "null"], "minimum": 0},
        "quote_count": {"type": ["integer", "null"], "minimum": 0},
        "share_count": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "metric_observation_statuses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_count", "like_count", "reply_count", "repost_count", "quote_count", "share_count"
      ],
      "properties": {
        "view_count": {"enum": ["OBSERVED", "NOT_PRESENT", "NOT_OBSERVED", "EXTRACTION_FAILED"]},
        "like_count": {"enum": ["OBSERVED", "NOT_PRESENT", "NOT_OBSERVED", "EXTRACTION_FAILED"]},
        "reply_count": {"enum": ["OBSERVED", "NOT_PRESENT", "NOT_OBSERVED", "EXTRACTION_FAILED"]},
        "repost_count": {"enum": ["OBSERVED", "NOT_PRESENT", "NOT_OBSERVED", "EXTRACTION_FAILED"]},
        "quote_count": {"enum": ["OBSERVED", "NOT_PRESENT", "NOT_OBSERVED", "EXTRACTION_FAILED"]},
        "share_count": {"enum": ["OBSERVED", "NOT_PRESENT", "NOT_OBSERVED", "EXTRACTION_FAILED"]}
      }
    },
    "approximate_views": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display", "normalized_approx", "precision", "source", "view_band",
        "observed_at", "extractor_version", "normalizer_version"
      ],
      "properties": {
        "display": {"type": "string", "minLength": 1, "maxLength": 32},
        "normalized_approx": {"type": "integer", "minimum": 0},
        "precision": {"const": "ROUNDED"},
        "source": {"const": "POST_DETAIL_PAGE"},
        "view_band": {"enum": ["LT_1K", "1K_10K", "10K_100K", "100K_1M", "1M_PLUS"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "extractor_version": {"type": "string", "minLength": 1},
        "normalizer_version": {"type": "string", "minLength": 1}
      }
    },
    "display_views": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display", "normalized_value", "precision", "source", "view_band",
        "observed_at", "extractor_version", "normalizer_version"
      ],
      "properties": {
        "display": {"type": "string", "minLength": 1, "maxLength": 32},
        "normalized_value": {"type": "integer", "minimum": 0},
        "precision": {"const": "DISPLAY_EXACT"},
        "source": {"const": "POST_DETAIL_PAGE"},
        "view_band": {"enum": ["LT_1K", "1K_10K", "10K_100K", "100K_1M", "1M_PLUS"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "extractor_version": {"type": "string", "minLength": 1},
        "normalizer_version": {"type": "string", "minLength": 1}
      }
    },
    "views": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_display", "normalized_value", "precision", "display_format", "source",
        "view_band", "observed_at", "extractor_version", "normalizer_version"
      ],
      "properties": {
        "raw_display": {"type": "string", "minLength": 1, "maxLength": 32},
        "normalized_value": {"type": "integer", "minimum": 0},
        "precision": {"enum": ["DISPLAY_EXACT", "ROUNDED"]},
        "display_format": {
          "enum": ["INTEGER", "JAPANESE_MAN", "JAPANESE_OKU", "OTHER_MAGNITUDE"]
        },
        "source": {"const": "POST_DETAIL_PAGE"},
        "view_band": {
          "enum": ["LT_1K", "1K_10K", "10K_100K", "100K_1M", "1M_PLUS"]
        },
        "observed_at": {"type": "string", "format": "date-time"},
        "extractor_version": {"type": "string", "minLength": 1},
        "normalizer_version": {"type": "string", "minLength": 1}
      }
    },
    "engagement_metric_displays": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "like_count": {"$ref": "#/$defs/engagementMetricDisplay"},
        "reply_count": {"$ref": "#/$defs/engagementMetricDisplay"},
        "repost_count": {"$ref": "#/$defs/engagementMetricDisplay"},
        "quote_count": {"$ref": "#/$defs/engagementMetricDisplay"},
        "share_count": {"$ref": "#/$defs/engagementMetricDisplay"}
      }
    },
    "media_type": {"type": ["string", "null"], "minLength": 1},
    "has_image": {"type": ["boolean", "null"]},
    "has_video": {"type": ["boolean", "null"]},
    "collection_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "page_url", "query", "position"],
      "properties": {
        "surface": {"enum": ["threads_search_card", "threads_post_detail"]},
        "page_url": {"type": ["string", "null"], "format": "uri"},
        "query": {"type": ["string", "null"]},
        "position": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "observed_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "value", "surface", "observed_at", "extractor_version"],
        "properties": {
          "field": {
            "enum": [
              "source_post_id", "author_name", "username", "text", "timestamp",
              "published_at_raw", "published_at", "published_timezone_basis",
              "topic_tags",
              "raw_sequence_indicator", "thread_position", "thread_total",
              "public_counters.view_count", "public_counters.like_count",
              "public_counters.reply_count", "public_counters.repost_count",
              "public_counters.quote_count", "public_counters.share_count", "media_type",
              "has_image", "has_video"
            ]
          },
          "value": {
            "oneOf": [
              {"type": "string"}, {"type": "integer"}, {"type": "boolean"},
              {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
            ]
          },
          "surface": {"enum": ["threads_search_card", "threads_post_detail"]},
          "observed_at": {"type": "string", "format": "date-time"},
          "extractor_version": {"type": "string", "minLength": 1}
        }
      }
    },
    "collected_at": {"type": "string", "format": "date-time"},
    "extractor_version": {"type": "string", "minLength": 1},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "engagementMetricDisplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_display", "normalized_value", "precision", "source", "observed_at",
        "extractor_version", "normalizer_version", "relationship_evidence", "metric_name"
      ],
      "properties": {
        "raw_display": {"type": "string", "minLength": 1, "maxLength": 32},
        "normalized_value": {"type": "integer", "minimum": 0},
        "precision": {"enum": ["DISPLAY_EXACT", "ROUNDED"]},
        "source": {"const": "POST_DETAIL_ENGAGEMENT_CONTROL"},
        "observed_at": {"type": "string", "format": "date-time"},
        "extractor_version": {"type": "string", "minLength": 1},
        "normalizer_version": {"type": "string", "minLength": 1},
        "relationship_evidence": {
          "enum": [
            "SVG_ARIA_LABEL_AND_LOCAL_NUMERIC_DISPLAY",
            "ACTION_ORDER_PRECEDING_REPLY_AND_LOCAL_NUMERIC_DISPLAY"
          ]
        },
        "metric_name": {"enum": ["like_count", "reply_count", "repost_count", "quote_count", "share_count"]}
      }
    }
  }
}
