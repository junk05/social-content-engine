{
  "schema_version": 1,
  "agents": [
    {
      "id": "ORCHESTRATOR",
      "responsibilities": ["plan", "dependency management", "review integration"],
      "allowed_paths": ["**"],
      "forbidden_paths": ["committed credentials"],
      "input_artifacts": ["spec/**", "review reports"],
      "output_artifacts": ["task decisions", "audit records"],
      "reviewers": ["QA_REVIEWER"],
      "dependencies": []
    },
    {
      "id": "COLLECTOR",
      "responsibilities": ["official API spike", "bounded batch collection", "pagination", "retry", "raw capture"],
      "allowed_paths": ["src/social_content_engine/collector/**", "tests/**", "spec/THREADS_API_CAPABILITIES.json"],
      "forbidden_paths": ["content generation", "automatic publishing"],
      "input_artifacts": ["official Meta documentation", "credentials via environment"],
      "output_artifacts": ["raw responses", "collection run provenance"],
      "reviewers": ["QA_REVIEWER"],
      "dependencies": ["HG-01 for live calls"]
    },
    {
      "id": "DATA",
      "responsibilities": ["storage", "normalization versioning", "dataset snapshots", "deduplication", "provenance"],
      "allowed_paths": ["src/social_content_engine/data/**", "spec/contracts/**", "spec/DATA_MODEL.md", "tests/**"],
      "forbidden_paths": ["external API policy decisions"],
      "input_artifacts": ["raw responses", "data contracts"],
      "output_artifacts": ["normalized posts", "storage migrations"],
      "reviewers": ["QA_REVIEWER"],
      "dependencies": ["COLLECTOR response contract"]
    },
    {
      "id": "INTELLIGENCE",
      "responsibilities": ["batch analysis", "feature extraction", "pattern mining", "pattern reports"],
      "allowed_paths": ["src/social_content_engine/analyzer/**", "src/social_content_engine/intelligence/**", "tests/**"],
      "forbidden_paths": ["content generation", "automatic publishing", "creator profiling"],
      "input_artifacts": ["normalized posts"],
      "output_artifacts": ["versioned analysis"],
      "reviewers": ["QA_REVIEWER"],
      "dependencies": ["M0 complete"]
    },
    {
      "id": "QA_REVIEWER",
      "responsibilities": ["tests", "schema validation", "security", "regression", "spec consistency"],
      "allowed_paths": ["tests/**", "scripts/**", ".github/**", "spec/**"],
      "forbidden_paths": ["credentials", "unspecified product scope"],
      "input_artifacts": ["specifications", "contracts", "fixtures", "implementation"],
      "output_artifacts": ["validation results", "review findings"],
      "reviewers": ["ORCHESTRATOR"],
      "dependencies": []
    }
  ]
}
