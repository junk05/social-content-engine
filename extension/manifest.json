{
  "manifest_version": 3,
  "name": "Social Content Engine - Threads Collector",
  "version": "0.1.0",
  "description": "Human-selected public Threads observation collector for a loopback receiver.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.threads.com/*",
        "https://www.threads.net/*"
      ],
      "js": [
        "extractor.js",
        "detail_extractor.js",
        "injection.js",
        "detail_action.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
